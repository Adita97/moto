# Server
PORT=3001
NODE_ENV=development

# Database
DB_PATH=./server/data/moto.db

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_generate_64_byte_hex
JWT_REFRESH_SECRET=CHANGE_ME_generate_different_64_byte_hex
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Admin credentials
# Generate hash: node -e "const b=require('bcryptjs');b.hash('YOUR_PASSWORD',12,(e,h)=>console.log(h))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$12$CHANGE_ME_WITH_BCRYPT_HASH

# CORS
ALLOWED_ORIGIN=http://localhost:5173

# Upload limits
MAX_FILE_SIZE_MB=20
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp
